{
  "manifest_version": 3,
  "name": "PDF G",
  "version": "1.3.1",
  "description": "Convierte, edita y crea PDF en tu navegador, sin subir nada. PDF a Excel, Word, imágenes, unir, dividir, comprimir, firmar, OCR y más.",
  "author": "Smith-Develop",
  "homepage_url": "https://github.com/Smith-Develop",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "PDF G", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "downloads"],
  "optional_permissions": ["debugger"],
  "optional_host_permissions": ["<all_urls>"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
